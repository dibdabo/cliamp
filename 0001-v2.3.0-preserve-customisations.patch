+func TestSpotSearchResultsRenderSelectionAndHelp(t *testing.T) {
+	m := Model{
+		plVisible: 4,
+		spotSearch: spotSearchState{
+			screen:   spotSearchResults,
+			results:  spotifySearchTestTracks(),
