+	return func() tea.Msg {
+		msg := spotAlbumTracksMsg{action: action, gen: gen, batch: true}
+		for _, result := range results {
+			if err := ctx.Err(); err != nil {
+				msg.err = err
+				return msg
+			}
+			if !result.IsAlbum() {
+				msg.tracks = append(msg.tracks, result)
+				continue
