+			tracks, err := loadSpotAlbumTracks(ctx, loader, result)
+			if err != nil {
+				msg.err = fmt.Errorf("opening %s: %w", result.Title, err)
+				return msg
+			}
+			msg.tracks = append(msg.tracks, tracks...)
+		}
+		return msg
+	}
