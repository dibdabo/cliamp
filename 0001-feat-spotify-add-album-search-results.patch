 func fetchSpotSearchCmd(ctx context.Context, s provider.Searcher, providerName, query string, gen uint64) tea.Cmd {
 	return func() tea.Msg {
+		if typed, ok := s.(provider.ResultSearcher); ok {
+			results, err := typed.SearchResults(ctx, query, 20)
