+// spotifyAlbum is the simplified album object returned by /v1/search.
+type spotifyAlbum struct {
+	ID          string          `json:"id"`
+	Name        string          `json:"name"`
+	URI         string          `json:"uri"`
+	Artists     []spotifyArtist `json:"artists"`
+	ReleaseDate string          `json:"release_date"`
+	TotalTracks int             `json:"total_tracks"`
+}
+
 // spotifyItem is a track or podcast episode object from the Spotify Web API.
 // Playlists can hold both; episodes carry a show instead of artists/album.
 type spotifyItem struct {
@@ -107,3 +118,21 @@ func trackFromItem(t *spotifyItem) playlist.Track {
 		Unplayable:   (t.IsPlayable != nil && !*t.IsPlayable) || t.Restrictions.Reason != "",
 	}
 }
+
+func albumFromItem(a *spotifyAlbum) provider.AlbumInfo {
+	artists := make([]string, len(a.Artists))
+	for i, artist := range a.Artists {
+		artists[i] = artist.Name
+	}
+	var year int
+	if len(a.ReleaseDate) >= 4 {
+		year, _ = strconv.Atoi(a.ReleaseDate[:4])
+	}
+	return provider.AlbumInfo{
+		ID:         a.ID,
+		Name:       a.Name,
+		Artist:     strings.Join(artists, ", "),
+		Year:       year,
+		TrackCount: a.TotalTracks,
+	}
+}
