+func TestSearchResultsPrefersAlbumForNaturalAlbumQuery(t *testing.T) {
+	originalTransport := http.DefaultTransport
+	http.DefaultTransport = roundTripFunc(func(req *http.Request) (*http.Response, error) {
+		if req.URL.Path != "/v1/search" {
+			return nil, fmt.Errorf("unexpected path %q", req.URL.Path)
+		}
+		if got := req.URL.Query().Get("q"); got != "Aja Steely Dan" {
+			t.Errorf("query = %q, want natural album hint removed", got)
+		}
+		if got := req.URL.Query().Get("type"); got != "album,track,episode" {
+			t.Errorf("types = %q, want album,track,episode", got)
+		}
+		body := `{
+			"albums":{"items":[{"id":"album-aja","name":"Aja","uri":"spotify:album:album-aja","release_date":"1977-09-23","total_tracks":7,"artists":[{"name":"Steely Dan"}]}]},
+			"tracks":{"items":[{"id":"track-aja","name":"Aja","type":"track","uri":"spotify:track:track-aja","artists":[{"name":"Steely Dan"}]}]},
+			"episodes":{"items":[]}
+		}`
+		return &http.Response{StatusCode: http.StatusOK, Status: "200 OK", Header: make(http.Header), Body: io.NopCloser(strings.NewReader(body)), Request: req}, nil
+	})
+	t.Cleanup(func() { http.DefaultTransport = originalTransport })
+
+	sess := &Session{tokenSource: oauth2.StaticTokenSource(&oauth2.Token{AccessToken: "token"})}
+	p := New(sess, "client", 320)
+	results, err := p.SearchResults(context.Background(), "Aja album Steely Dan", 10)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(results) != 2 || results[0].Kind != provider.SearchResultAlbum {
+		t.Fatalf("results = %+v, want album before track", results)
+	}
+	album := results[0].Album
+	if album.ID != "album-aja" || album.Name != "Aja" || album.Artist != "Steely Dan" || album.Year != 1977 || album.TrackCount != 7 {
+		t.Fatalf("album result = %+v", album)
+	}
+}
+
+func TestAlbumTracksReturnsCompleteOrderedAlbum(t *testing.T) {
+	originalTransport := http.DefaultTransport
+	http.DefaultTransport = roundTripFunc(func(req *http.Request) (*http.Response, error) {
+		if req.URL.Path != "/v1/albums/album-aja/tracks" {
+			return nil, fmt.Errorf("unexpected path %q", req.URL.Path)
+		}
+		body := `{"items":[
+			{"id":"black-cow","name":"Black Cow","type":"track","uri":"spotify:track:black-cow","track_number":1,"artists":[{"name":"Steely Dan"}]},
+			{"id":"aja","name":"Aja","type":"track","uri":"spotify:track:aja","track_number":2,"artists":[{"name":"Steely Dan"}]}
+		],"total":2}`
+		return &http.Response{StatusCode: http.StatusOK, Status: "200 OK", Header: make(http.Header), Body: io.NopCloser(strings.NewReader(body)), Request: req}, nil
+	})
+	t.Cleanup(func() { http.DefaultTransport = originalTransport })
+
+	sess := &Session{tokenSource: oauth2.StaticTokenSource(&oauth2.Token{AccessToken: "token"})}
+	p := New(sess, "client", 320)
+	tracks, err := p.AlbumTracks("album-aja")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(tracks) != 2 || tracks[0].Title != "Black Cow" || tracks[1].Title != "Aja" {
+		t.Fatalf("tracks = %+v, want album order", tracks)
+	}
+}
