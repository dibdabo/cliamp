+// SearchResults returns typed Spotify albums, tracks, and episodes. A standalone
+// word "album" is treated as a natural-language type hint: it is removed from
+// the API query and album hits are placed before track hits. Spotify's explicit
+// field syntax (for example album:Aja) is passed through unchanged.
+func (p *SpotifyProvider) SearchResults(ctx context.Context, query string, limit int) ([]provider.SearchResult, error) {
+	if err := p.ensureSession(); err != nil {
+		return nil, err
+	}
+
+	if limit < 1 {
+		limit = 1
+	} else if limit > 50 {
+		limit = 50
+	}
+
+	apiQuery, preferAlbums := spotifySearchQuery(query)
+	result, err := p.searchPage(ctx, apiQuery, "album,track,episode", limit, 0)
+	if err != nil && isInvalidLimit(err) && limit > devModeSearchLimit {
+		result, err = p.searchPaged(ctx, apiQuery, "album,track,episode", limit)
+	}
+	if err != nil {
+		return nil, friendlySearchError(err)
+	}
+
+	albums := make([]provider.SearchResult, 0, len(result.Albums.Items))
+	for _, album := range result.Albums.Items {
+		if album == nil || album.ID == "" {
+			continue
+		}
+		albums = append(albums, provider.SearchResult{Kind: provider.SearchResultAlbum, Album: albumFromItem(album)})
+	}
+
+	tracks := make([]provider.SearchResult, 0, len(result.Tracks.Items)+len(result.Episodes.Items))
+	for _, items := range [][]*spotifyItem{result.Tracks.Items, result.Episodes.Items} {
+		for _, item := range items {
+			if item == nil || item.ID == "" {
+				continue
+			}
+			kind := provider.SearchResultTrack
+			if item.Type == "episode" {
+				kind = provider.SearchResultEpisode
+			}
+			tracks = append(tracks, provider.SearchResult{Kind: kind, Track: trackFromItem(item)})
+		}
+	}
+
+	if preferAlbums {
+		return append(albums, tracks...), nil
+	}
+	return append(tracks, albums...), nil
+}
+
+func spotifySearchQuery(query string) (string, bool) {
+	fields := strings.Fields(query)
+	filtered := make([]string, 0, len(fields))
+	preferAlbums := false
+	for _, field := range fields {
+		if strings.EqualFold(field, "album") {
+			preferAlbums = true
+			continue
+		}
+		filtered = append(filtered, field)
+	}
+	if len(filtered) == 0 {
+		return query, preferAlbums
+	}
+	return strings.Join(filtered, " "), preferAlbums
+}
+
+// AlbumTracks resolves a Spotify album to its complete track list in disc and
+// track order. Search-result metadata fills album/year fields in the UI.
+func (p *SpotifyProvider) AlbumTracks(albumID string) ([]playlist.Track, error) {
+	if err := p.ensureSession(); err != nil {
+		return nil, err
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+
+	var tracks []playlist.Track
+	offset := 0
+	for {
+		q := url.Values{
+			"limit":  {strconv.Itoa(spotifyTrackPageSize)},
+			"offset": {strconv.Itoa(offset)},
+		}
+		resp, err := p.webAPI(ctx, "GET", fmt.Sprintf("/v1/albums/%s/tracks", albumID), q)
+		if err != nil {
+			return nil, fmt.Errorf("spotify: album tracks: %w", err)
+		}
+		var page struct {
+			Items []*spotifyItem `json:"items"`
+			Total int            `json:"total"`
+		}
+		if err := decodeBody(resp, &page); err != nil {
+			return nil, fmt.Errorf("spotify: parse album tracks: %w", err)
+		}
+		for _, item := range page.Items {
+			if item == nil || item.ID == "" {
+				continue
+			}
+			tracks = append(tracks, trackFromItem(item))
+		}
+		if offset+spotifyTrackPageSize >= page.Total {
+			break
+		}
+		offset += spotifyTrackPageSize
+	}
+	return tracks, nil
+}
