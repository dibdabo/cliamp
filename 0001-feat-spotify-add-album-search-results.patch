+// SearchResultKind distinguishes immediately playable results from containers
+// such as albums whose tracks are resolved only when the user acts on them.
+type SearchResultKind string
+
+const (
+	SearchResultTrack   SearchResultKind = "track"
+	SearchResultEpisode SearchResultKind = "episode"
+	SearchResultAlbum   SearchResultKind = "album"
+)
+
+// SearchResult is a typed provider search hit. Track is populated for track
+// and episode results; Album is populated for album results.
+type SearchResult struct {
+	Kind  SearchResultKind
+	Track playlist.Track
+	Album AlbumInfo
+}
+
 // SortType describes one sort option for album listing.
 type SortType struct {
 	ID    string // e.g. "alphabeticalByName"
