+
+func resolveSpotSearchResultsCmd(prov playlist.Provider, results []provider.SearchResult, action spotSearchAction, gen uint64) tea.Cmd {
+	return func() tea.Msg {
+		loader, _ := prov.(provider.AlbumTrackLoader)
+		var tracks []playlist.Track
+		seen := make(map[string]bool)
+		for _, result := range results {
+			if result.Kind != provider.SearchResultAlbum {
+				if result.Track.Path != "" && !seen[result.Track.Path] {
+					seen[result.Track.Path] = true
+					tracks = append(tracks, result.Track)
+				}
+				continue
+			}
+			if loader == nil {
+				return spotSearchResolvedMsg{action: action, providerName: prov.Name(), gen: gen, err: fmt.Errorf("%s cannot load album tracks", prov.Name())}
+			}
+			albumTracks, err := loader.AlbumTracks(result.Album.ID)
+			if err != nil {
+				return spotSearchResolvedMsg{action: action, providerName: prov.Name(), gen: gen, err: err}
+			}
+			for _, track := range albumTracks {
+				if track.Album == "" {
+					track.Album = result.Album.Name
+				}
+				if track.Artist == "" {
+					track.Artist = result.Album.Artist
+				}
+				if track.Year == 0 {
+					track.Year = result.Album.Year
+				}
+				if track.Path != "" && !seen[track.Path] {
+					seen[track.Path] = true
+					tracks = append(tracks, track)
+				}
+			}
+		}
+		return spotSearchResolvedMsg{tracks: tracks, action: action, providerName: prov.Name(), gen: gen}
 	}
 }
 
